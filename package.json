{
  "name": "codex-monitor",
  "version": "0.1.0",
  "description": "Event-driven monitors for the Codex CLI: pause the agent until an arbitrary condition becomes true. No LLM polling loops.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "codex-monitor": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "codex",
    "mcp",
    "model-context-protocol",
    "monitor",
    "agent",
    "wait",
    "condition",
    "openai-codex"
  ]
}
